NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio
# Génère une valeur avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CLIENT_URL=http://localhost:5173

# Lus uniquement par : npm run admin:creer et npm run admin:reinitialiser
ADMIN_EMAIL=
ADMIN_MOT_DE_PASSE=

# Notification par courriel via l'API Resend (optionnel : laisser COURRIEL_CLE_API vide pour désactiver)
# Avec l'expéditeur de test onboarding@resend.dev, le destinataire doit être l'adresse du compte Resend.
COURRIEL_CLE_API=
COURRIEL_EXPEDITEUR=
COURRIEL_DESTINATAIRE=
