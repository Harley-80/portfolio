{
    "name": "portfolio-serveur",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "API REST du portfolio (Express + MongoDB)",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "node --watch --env-file=.env src/serveur.js",
        "start": "node src/serveur.js",
        "admin:creer": "node --env-file=.env src/scripts/creerAdmin.js",
        "test": "node --test",
        "admin:reinitialiser": "node --env-file=.env src/scripts/reinitialiserAdmin.js"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "express": "^4.22.3",
        "express-rate-limit": "^8.7.1",
        "express-validator": "^7.3.2",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^8.24.5",
        "nodemailer": "^10.0.15"
    },
    "devDependencies": {
        "supertest": "^7.3.1"
    }
}